import java.applet.Applet;
import java.awt.*;
import java.util.Random;

/*
<applet code="ConcentricCircles.class" width="500" height="500">
</applet>
*/

public class cc extends Applet {

    public void paint(Graphics g) {

        Random r = new Random();

        int centerX = 250;
        int centerY = 250;

        // Draw concentric circles
        for (int radius = 20; radius <= 120; radius += 10) {

            // Random color
            Color c = new Color(
                    r.nextInt(256),
                    r.nextInt(256),
                    r.nextInt(256)
            );

            g.setColor(c);

            // Draw circle
            g.drawOval(centerX - radius,
                       centerY - radius,
                       2 * radius,
                       2 * radius);
        }
    }
}


